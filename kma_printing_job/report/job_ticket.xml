<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_job_ticket" model="ir.actions.report">
        <field name="name">Job Ticket</field>
        <field name="model">kma.printing.job</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kma_printing_job.report_job_ticket</field>
        <field name="report_file">kma_printing_job.report_job_ticket</field>
        <field name="print_report_name">'Job Ticket - %s' % object.name</field>
        <field name="binding_model_id" ref="model_kma_printing_job"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_job_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Job Ticket <span t-field="o.name"/></h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-4"><strong>Customer</strong><br/><span t-field="o.partner_id"/></div>
                            <div class="col-3"><strong>Sales Order</strong><br/><span t-field="o.sale_order_id"/></div>
                            <div class="col-3"><strong>Deadline</strong><br/><span t-field="o.date_deadline"/></div>
                            <div class="col-2"><strong>Designer</strong><br/><span t-field="o.designer_id"/></div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead><tr><th>Item</th><th>Specification</th><th>Process</th><th class="text-end">Quantity</th><th>Artwork</th><th>MO</th><th>Stage</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.line_ids.filtered(lambda l: l.stage != 'cancel')" t-as="l">
                                    <td><span t-field="l.product_id"/></td>
                                    <td><span t-field="l.name"/></td>
                                    <td><span t-field="l.print_process"/></td>
                                    <td class="text-end"><span t-field="l.product_uom_qty"/> <span t-field="l.product_uom"/></td>
                                    <td><t t-if="l.current_proof_id"><span t-out="l.current_proof_id.name"/> · <span t-field="l.current_proof_id.state"/></t></td>
                                    <td><span t-field="l.production_id"/></td>
                                    <td><span t-field="l.stage"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="o.note"><strong>Production notes</strong><div t-field="o.note"/></div>
                        <table class="table table-sm mt-4">
                            <thead><tr><th>Quality check</th><t t-foreach="o.line_ids.filtered(lambda l: l.stage != 'cancel')" t-as="l"><th t-out="l.product_id.name"/></t></tr></thead>
                            <tbody>
                                <tr t-foreach="o.env['kma.printing.qc.template'].search([])" t-as="q">
                                    <td t-out="q.name"/>
                                    <t t-foreach="o.line_ids.filtered(lambda l: l.stage != 'cancel')" t-as="l"><td>&#160;</td></t>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
