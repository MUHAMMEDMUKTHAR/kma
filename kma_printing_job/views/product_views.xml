<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_printing" model="ir.ui.view">
        <field name="name">product.template.form.printing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="kma_is_printable"/>
                <field name="kma_print_process" invisible="not kma_is_printable"/>
                <field name="kma_requires_artwork" invisible="not kma_is_printable"/>
            </xpath>
        </field>
    </record>
</odoo>
