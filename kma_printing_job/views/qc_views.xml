<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qc_template_tree" model="ir.ui.view">
        <field name="name">kma.printing.qc.template.tree</field>
        <field name="model">kma.printing.qc.template</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>
    <record id="action_qc_template" model="ir.actions.act_window">
        <field name="name">QC Checklist</field>
        <field name="res_model">kma.printing.qc.template</field>
        <field name="view_mode">tree</field>
    </record>
    <record id="action_printable_products" model="ir.actions.act_window">
        <field name="name">Printable Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('kma_is_printable', '=', True)]</field>
        <field name="context">{'default_kma_is_printable': True, 'default_detailed_type': 'product'}</field>
    </record>
</odoo>
