<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_printing" model="ir.module.category">
        <field name="name">Printing</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_printing_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_printing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_printing_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_printing"/>
        <field name="implied_ids" eval="[(4, ref('group_printing_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
